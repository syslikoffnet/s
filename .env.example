# ─── Healdragg ────────────────────────────────────────────────────────────────
# Скопируй в .env и заполни. Все параметры можно задать и переменными окружения.

# Telegram API (my.telegram.org → API development tools)
API_ID=
API_HASH=

# Токен бота от @BotFather
BOT_TOKEN=

# Кому разрешено пользоваться ботом (id через запятую). Свой id узнаешь командой /id
BOT_ALLOWED_USERS=

# Разрешить бота всем (true/false). Не рекомендуется: бот показывает чужие публичные чаты
BOT_ALLOW_ALL=false

# Токен для веб-панели и Android-приложения (если пусто — сгенерируется при init)
API_TOKEN=

# ─── Пути ─────────────────────────────────────────────────────────────────────
HEALDRAGG_HOME=data
DB_PATH=data/healdragg.db
SESSIONS_DIR=data/sessions

# ─── Сеть / панель ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ─── Сканер ───────────────────────────────────────────────────────────────────
# Пауза между запросами к Telegram (сек). Меньше 1.0 — риск FloodWait
SCAN_MIN_DELAY=1.4
SCAN_JITTER=0.6
# Сколько групп максимум проверять за один прогон
SCAN_MAX_GROUPS=2000
# Лимит вступлений в публичные группы за сутки на сессию (0 — не вступать)
JOIN_LIMIT=20
# Автоматически проверять цель сразу после добавления в боте
AUTO_SCAN_ON_ADD=true
# Вступать в найденные публичные чаты при сборе базы из бота/панели
JOIN_ON_BOOTSTRAP=false
# Сколько читать сообщений цели для графа «с кем общается»
ACTIVITY_DAYS=30
ACTIVITY_PER_CHAT=40
ACTIVITY_MAX_CHATS=80
# Алерты: push в бот, интервал проверки, авто-обход и авто-сбор активности
ALERT_PUSH=true
ALERT_INTERVAL=20
AUTOPILOT_MINUTES=0
AUTO_ACTIVITY_ON_SCAN=false
# Через сколько часов обновлять метаданные группы (последнее сообщение, счётчик)
META_TTL_HOURS=12

# ─── Вид ──────────────────────────────────────────────────────────────────────
PAGE_SIZE=15
TITLE_LIMIT=15
TZ=Europe/Moscow
LOG_LEVEL=INFO
